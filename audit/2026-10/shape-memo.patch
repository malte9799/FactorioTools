+  const shapeProfiles = new Map<string, AnimProfile>();
+  function probeShape(entity: PlacedEntity, visual: ResolvedVisual, baseCtx: CollectContext, emitted: DrawCommand[]): AnimProfile {
+    const key = `${entity.name}|${entity.direction}|${Math.abs(Math.round(entity.x) + Math.round(entity.y)) % 2}|${entity.undergroundType ?? ""}|`
