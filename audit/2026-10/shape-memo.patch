+    let profile = shapeProfiles.get(key);
+    if (!profile) {
+      const probed = probe(entity, visual, baseCtx);
+      profile = probed.commandCount === emitted.length ? probed : NO_ANIMATION;
+      shapeProfiles.set(key, profile);
+    }
+    return profile;
   }
 
